# Salin ke .env.local lalu isi. Token TIDAK disimpan di sini —
# simpan di macOS Keychain lewat: npm run token:confluence

# Data Center/Server: https://confluence.perusahaan.co.id
# Cloud:              https://namaorg.atlassian.net/wiki
CONFLUENCE_BASE_URL=

# bearer = Personal Access Token (Data Center), basic = email + API token (Cloud)
CONFLUENCE_AUTH=bearer

# Hanya untuk CONFLUENCE_AUTH=basic
CONFLUENCE_EMAIL=

# InferHub (https://inferhub.dev/dashboard)
# Token disimpan di Keychain: npm run token:inferhub
# Atau isi INFERHUB_API_KEY di sini (opsional bila sudah di Keychain)
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev
INFERHUB_MODEL=ag/claude-sonnet-4-6

# 9Router AI Gateway (https://ai.diwebin.web.id atau lokal http://localhost:20128)
# Token disimpan di Keychain: npm run token:9router
# NINEROUTER_BASE_URL=https://ai.diwebin.web.id/v1
# NINEROUTER_API_KEY=
# NINEROUTER_MODEL=ag/claude-sonnet-4-6


